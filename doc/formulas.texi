@node Instantiate
@subsection Instantiate
@cindex pouring a molecule
@cindex wisping a molecule

@table @kbd
@item p
Pour --- create a persistent molecule from a proto.
@item w
Wisp --- create an ephemeral molecule.
@end table

@node Combine
@subsection Combine
@cindex bonding molecules
@cindex distilling a molecule

@table @kbd
@item b
Bond --- merge molecules together.
@item d
Distill --- extract a proto from existing issues.
@end table

@node Molecule Lifecycle
@subsection Molecule Lifecycle
@cindex molecule progress

@table @kbd
@item s
Show molecule details.
@item c
Show the current active molecule.
@item P
Show molecule progress.
@end table

@node Cleanup
@subsection Cleanup
@cindex squashing a molecule
@cindex burning a molecule

@table @kbd
@item S
Squash --- collapse molecule history.
@item B
Burn --- destroy a molecule.
@end table

@node Find and Health
@subsection Find and Health
@cindex stale molecules
@cindex molecule seed

@table @kbd
@item r
Ready --- find molecules ready for work.
@item t
Stale --- find stale molecules.
@item e
Seed --- verify molecule seed data integrity.
@item l
