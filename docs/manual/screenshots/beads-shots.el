;;; Commentary:

;; The beads.el-specific half of the documentation screenshot pipeline.
;; It puts beads.el on the `load-path', configures the reusable engine in
;; `screenshot.el' (copied verbatim from the sibling gascity.el pipeline),
;; and defines one thunk per view.  `capture.sh' runs this file once per
;; theme.
;;
;; The engine is package-agnostic and must stay that way: this file only
;; sets the configuration variables and provides views.
;;
;; Configuration is read from the environment so one script serves every
;; theme and selection:
;;
;;   BEADS_REPO          beads.el checkout (default: derived from this file)
;;   BEADS_SHOT_THEME    theme symbol, e.g. ef-elea-dark
;;   BEADS_SHOT_OUTDIR   directory for the raw PNGs
;;   BEADS_SHOT_SUFFIX   appended to every shot name, e.g. -dark
;;   BEADS_SHOT_VIEWS    space-separated view names; empty = all
;;   BEADS_SHOT_DIR      project directory the views open against (the
;;                       temporary fixture store created by fixture.sh)
;;
;; Run from `capture.sh' under a graphical (headless) Emacs; it exits when
;; done.

;;; Code:

(defvar beads-shots-dir
  (file-name-directory (or load-file-name buffer-file-name default-directory))
  "Directory containing this file (docs/manual/screenshots/).")

(defun beads-shots-getenv (name default)
  "Return environment NAME, or DEFAULT when unset or empty."
  (let ((v (getenv name)))
    (if (and v (not (string-empty-p v))) v default)))

(let* ((repo (beads-shots-getenv
              "BEADS_REPO" (expand-file-name "../../.." beads-shots-dir))))
  (add-to-list 'load-path (expand-file-name "lisp" repo))
  (add-to-list 'load-path beads-shots-dir))

(require 'cl-lib)
(require 'screenshot)
(require 'beads)
;; Load the view modules explicitly: the shot list runs from a bare
;; `emacs -Q -l', where the package's generated autoloads file is absent.
;; `transient-setup' looks up the prefix object directly and
;; `beads-molecule' is not autoloaded, so every view module is required.
(require 'beads-dashboard)
(require 'beads-command-list)
(require 'beads-command-show)
(require 'beads-compose)
(require 'beads-molecule)
(require 'beads-swarm)
(require 'beads-agent)
(require 'beads-agent-list)
(require 'beads-menu)
(require 'beads-command-formula)

;;; Engine configuration

(defun beads-shots--progress (fmt &rest args)
  "Append a progress line to BEADS_SHOT_OUTDIR/capture.log and stderr."
  (let* ((dir (beads-shots-getenv "BEADS_SHOT_OUTDIR" temporary-file-directory))
         (line (concat (format-time-string "%T.%3N ") (apply #'format fmt args) "\n")))
    (ignore-errors
      (let ((coding-system-for-write 'utf-8))
        (write-region line nil (expand-file-name "capture.log" dir) t 'silent)))
    (princ line #'external-debugging-output)))

;; beads.el fetches every view's data through these two async process
;; names (`beads-command.el'): the command runner and the dashboard's
;; server-vs-embedded policy probe.  The engine's `screenshot-settle'
;; waits until no live process matches, so the dashboard and eldoc data
;; have landed before a frame is exported.
(setq screenshot-output-dir
      (beads-shots-getenv "BEADS_SHOT_OUTDIR" temporary-file-directory)
      screenshot-theme
      (intern (beads-shots-getenv "BEADS_SHOT_THEME" "ef-elea-dark"))
      screenshot-theme-library "ef-themes"
      screenshot-async-process-regexp "beads-async\\|beads-policy-probe"
      screenshot-log-function #'beads-shots--progress)

;;; Deterministic role ids (defense in depth)

(defvar beads-shots-role-prefix "demo"
  "Fixture id prefix; ids outside it are not touched by normalization.")

(defun beads-shots--normalize-ids (buffer)
  "Map any run-generated bead id in BUFFER back to a stable role token.
The fixture pins ids `demo-<n>' (see fixtures/beads-fixture.jsonl), so a
matching id is a role and is left alone.  An id that shares the fixture
prefix but is not `demo-<digits>' was generated by the store at run time
and is replaced with `demo-role', so a stray hash can never reach a
committed image.  Ids with other prefixes are ordinary hyphenated words
and are ignored."
  (when (buffer-live-p buffer)
    (with-current-buffer buffer
      (let ((prefix (concat (regexp-quote beads-shots-role-prefix) "-")))
        (save-excursion
          (goto-char (point-min))
          (while (re-search-forward beads-issue-id-regexp nil t)
            (let ((id (match-string 1)))
              (when (and (string-prefix-p prefix id)
                         (not (string-match-p
                               (concat "\\`" prefix "[0-9]+\\'") id)))
                (replace-match (concat beads-shots-role-prefix "-role")
                               t t nil 1)))))))))

(defun beads-shots--normalize-frame (frame)
  "Normalize every buffer displayed in a window of FRAME."
  (dolist (window (window-list frame nil))
    (beads-shots--normalize-ids (window-buffer window))))

;; The engine is copied verbatim, so the normalization is a post-render
;; hook installed from this call site rather than a change to the engine.
(advice-add 'screenshot-export :before
            (lambda (buffer _name &optional _fixed-rows)
              (beads-shots--normalize-ids (get-buffer buffer))))
(advice-add 'screenshot-export-frame :before
            (lambda (_name)
              (beads-shots--normalize-frame (selected-frame))))

;; The dashboard mode line renders a wall-clock relative timestamp
;; ("refreshed 0s ago").  How long the asynchronous settle takes is not
;; part of the view, so pin the label for capture; otherwise two separate
;; invocations can differ by a second and `--verify'/`--scope all' stop
;; being byte-identical (REQ-007).  This affects only this screenshot
;; process -- the product keeps its live relative time.
(advice-add 'beads-dashboard--format-relative-time :override
            (lambda (&rest _) "0s ago"))

;;; View thunks
;;
;; Each thunk opens a view and returns the buffer to capture.  The vui
;; dashboards end in `pop-to-buffer', so the selected window shows the
;; view afterwards; the tabulated lists name their own buffers.

(defun beads-shots--selected-buffer ()
  "Return the buffer the selected window shows (views pop to theirs)."
  (window-buffer (selected-window)))

(defun beads-shots--open (fn &rest args)
  "Call FN with ARGS and return the buffer it shows or returns."
  (let ((ret (apply fn args)))
    (or (and (bufferp ret) (buffer-live-p ret) ret)
        (beads-shots--selected-buffer))))

(defun beads-shots--loading-p (buffer)
  "Return non-nil while BUFFER still shows a loading marker.
The dashboard and molecule views render a `…' placeholder until their
async section loads."
  (and (buffer-live-p buffer)
       (with-current-buffer buffer
         (save-excursion
           (goto-char (point-min))
           (re-search-forward "\\(?:^\\|  \\)…$" nil t)))))

(defun beads-shots--await (buffer &optional seconds)
  "Wait (at most SECONDS, default 30) until BUFFER has finished loading.
Then clear the echo area, so the export shows no stray message."
  (let ((deadline (+ (float-time) (or seconds 30))))
    (while (and (beads-shots--loading-p buffer) (< (float-time) deadline))
      (accept-process-output nil 0.1))
    (when (beads-shots--loading-p buffer)
      (beads-shots--progress "still loading after %ss: %s"
                             (or seconds 30) (buffer-name buffer)))
    ;; One more beat for the last render to land.
    (accept-process-output nil 0.3)
    (message nil)
    buffer))

(defun beads-shots--ready (thunk)
  "Wrap view THUNK: call it, then wait for its buffer to finish loading."
  (lambda () (beads-shots--await (funcall thunk))))

(defun beads-shots--dashboard-buffer ()
  "Open the project pulse dashboard (`beads-dashboard')."
  (beads-dashboard)
  (beads-shots--selected-buffer))

(defun beads-shots--list-buffer ()
  "Open the full issue list."
  (beads-list-issues))

(defun beads-shots--ready-buffer ()
  "Open the ready-work list."
  (beads-ready)
  (beads-shots--selected-buffer))

(defun beads-shots--blocked-buffer ()
  "Open the blocked-issues list."
  (beads-blocked)
  (beads-shots--selected-buffer))

(defun beads-shots--show-buffer (issue-id)
  "Open ISSUE-ID's detail buffer."
  (beads-show issue-id)
  (beads-shots--selected-buffer))

(defun beads-shots--compose-buffer ()
  "Open the issue-creation compose buffer."
  (beads-shots--open #'beads-compose-create))

(defun beads-shots--molecule-buffer ()
  "Open the molecule view of the fixture manual epic (`demo-10')."
  (beads-molecule "demo-10")
  (beads-shots--selected-buffer))

(defun beads-shots--swarm-buffer ()
  "Open the swarm fleet list."
  (beads-swarm-list-view)
  (beads-shots--selected-buffer))

(defun beads-shots--agents-buffer ()
  "Open the agent session list."
  (beads-agent-list)
  (beads-shots--selected-buffer))

(defun beads-shots--transient-frame (prefix)
  "Show transient PREFIX in the current frame and return nil.
:whole-frame shots export the frame as arranged by the thunk."
  (transient-setup prefix)
  (redisplay t)
  nil)

(defun beads-shots-all ()
  "Return the full alist of shots: (NAME THUNK . PROPS)."
  (list
   ;; vui / section views — auto-fit height.
   (list "dashboard" #'beads-shots--dashboard-buffer :settle 20)
   (list "show" (lambda () (beads-shots--show-buffer "demo-4")) :settle 15)
   (list "epic" (lambda () (beads-shots--show-buffer "demo-10")) :settle 15)
   (list "molecule" #'beads-shots--molecule-buffer :settle 20)
   (list "swarm" #'beads-shots--swarm-buffer :settle 15)
   ;; tabulated lists — extra row pad so short lists stay on one page.
   (list "list" #'beads-shots--list-buffer :settle 15 :row-pad 2)
   (list "ready" #'beads-shots--ready-buffer :settle 15 :row-pad 2)
   (list "blocked" #'beads-shots--blocked-buffer :settle 15 :row-pad 2)
   (list "agents" #'beads-shots--agents-buffer :settle 10 :row-pad 2)
   ;; compose buffer.
   (list "compose" #'beads-shots--compose-buffer :settle 8)
   ;; overlay / transient UI — capture the whole frame.
   (list "dispatch" (lambda () (beads-shots--transient-frame 'beads-dispatch))
         :whole-frame t)
   (list "maintenance" (lambda () (beads-shots--transient-frame 'beads-maintenance))
         :whole-frame t)
   (list "agent-menu" (lambda () (beads-shots--transient-frame 'beads-agent))
         :whole-frame t)
   (list "formula" (lambda () (beads-shots--transient-frame 'beads-formula-menu))
         :whole-frame t)))

(defun beads-shots--wrapped ()
  "Return `beads-shots-all' with every buffer thunk waiting for its data."
  (mapcar (lambda (shot)
            (if (plist-get (cddr shot) :whole-frame)
                shot
              (cons (car shot)
                    (cons (beads-shots--ready (cadr shot)) (cddr shot)))))
          (beads-shots-all)))

(defun beads-shots-selected ()
  "Return the shots requested by BEADS_SHOT_VIEWS (or all), suffixed."
  (let* ((suffix (beads-shots-getenv "BEADS_SHOT_SUFFIX" ""))
         (want (split-string (beads-shots-getenv "BEADS_SHOT_VIEWS" "") nil t))
         (all (beads-shots--wrapped))
         (chosen (if want
                     (cl-remove-if-not (lambda (s) (member (nth 0 s) want)) all)
                   all)))
    (mapcar (lambda (s)
              (cons (concat (nth 0 s) suffix) (cdr s)))
            chosen)))

;;; Entry point

(defun beads-shots-run ()
  "Capture the selected shots, then exit."
  ;; Watchdog: the outer `timeout' is the hard backstop, but kill ourselves
  ;; first if a view wedges, so the wrapper sees a clean exit.
  (run-with-timer (string-to-number
                   (beads-shots-getenv "BEADS_SHOT_WATCHDOG" "400"))
                  nil (lambda ()
                           (beads-shots--progress "WATCHDOG-KILL")
                           (kill-emacs 3)))
  (condition-case err
      (progn
        (screenshot-init)
        (set-frame-size (selected-frame) 200 58)
        (setq default-directory
              (file-name-as-directory
               (or (beads-shots-getenv "BEADS_SHOT_DIR" nil)
                   (error "BEADS_SHOT_DIR must point at the fixture project (run via capture.sh)"))))
        (beads-shots--progress "theme=%s outdir=%s dir=%s"
                               screenshot-theme screenshot-output-dir
                               default-directory)
        (screenshot-run (beads-shots-selected))
        (beads-shots--progress "DONE")
        (kill-emacs 0))
    (error (beads-shots--progress "FATAL: %S" err)
           (kill-emacs 1))))

(beads-shots-run)

;;; beads-shots.el ends here
