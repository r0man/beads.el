## Makefile.am --- Autotools build rules for beads.el
##
## Targets:
##   make            byte-compile lisp/*.el (warnings are errors) and
##                   generate beads-autoloads.el
##   make info       build the Texinfo manual (doc/beads.info)
##   make html       build the self-contained HTML manual
##   make pdf        build the PDF manual
##   make install    install *.el, *.elc, beads-autoloads.el and the Info manual
##   make dist       build the distribution tarball
##
## `make check' and `make lint' are the W2 quality gates (REQ-006,
## REQ-008).  check runs the whole ERT suite in one plain-Emacs batch and
## runs the full (including `:integration') suite only when configure
## found bd, dolt and graphviz; --with-<tool>=no forces the `:unit'
## subset.  lint runs package-lint plus the byte-compile
## warnings-as-errors gate.  Both have no Eldev dependency.
##
## This file is deliberately portable Automake: the Elisp file lists are
## expanded by configure (see `configure.ac'), and no GNU make function
## (`$(wildcard)', `$(filter-out)', `$(notdir)', ...) appears here, so
## `autoreconf -Wall' is clean.

ACLOCAL_AMFLAGS = -I m4

## Recurse into doc/ so `make', `make info', `make html', `make pdf',
## `make install' and `make dist' all build, install and ship the manual
## through doc/Makefile.am (REQ-002, REQ-014).
SUBDIRS = doc

EMACS = @EMACS@

## Dependency load-path flags resolved by configure (`--with-transient=DIR'
## / `--with-vui=DIR'); ambient EMACSLOADPATH (the Guix path) is passed
## through untouched.  scripts/lint and scripts/coverage take the same
## directories.
TRANSIENT_DIR = @with_transient@
VUI_DIR = @with_vui@
DEP_LOAD_PATH = @DEP_LOAD_PATH@

EMACS_BATCH = $(EMACS) --batch -L "$(abs_top_srcdir)/lisp" $(DEP_LOAD_PATH)
COMPILE_HELPER = "$(abs_top_srcdir)/build-aux/beads-compile.el"
AUTOLOADS_HELPER = "$(abs_top_srcdir)/build-aux/beads-autoloads.el"
CHECK_HELPER = "$(abs_top_srcdir)/build-aux/beads-check.el"
LINT_HELPER = "$(abs_top_srcdir)/build-aux/beads-lint.el"
LINT_SCRIPT = "$(abs_top_srcdir)/scripts/lint"
COVERAGE_SCRIPT = "$(abs_top_srcdir)/scripts/coverage"

## `make check' invokes Emacs with -Q so the suite sees only the checkout
## and the resolved dependencies; `$(DEP_LOAD_PATH)' and the ambient
## EMACSLOADPATH still put transient/vui on the load path.
EMACS_BATCH_Q = $(EMACS) --batch -Q -L "$(abs_top_srcdir)/lisp" $(DEP_LOAD_PATH)

## configure's bd/dolt/graphviz conditionals, forwarded to the ERT runner
## so it can pick the full or `:unit'-only selector (and name what is
## missing).  `--with-bd=no' turns HAVE_BD off and thus forces :unit.
if HAVE_BD
check_have_bd = yes
else
check_have_bd = no
endif
if HAVE_DOLT
check_have_dolt = yes
else
check_have_dolt = no
endif
if HAVE_GRAPHVIZ
check_have_graphviz = yes
else
check_have_graphviz = no
endif

## Elisp file lists, expanded by configure so this file needs no GNU make
## functions.  `BEADS_LISP_FILES' carries the `$(srcdir)' prefix (used as
## prerequisites and in EXTRA_DIST, where automake strips it); the
## basename lists drive install/uninstall; `BEADS_LISP_COMPILED' lands in
## the build tree (`$(builddir)/lisp') so a VPATH build works and a
## read-only source tree stays free of `*.elc' (RF-1).  `$(builddir)' is
## `.` for an in-tree build, preserving the historical layout.
BEADS_LISP_FILES = @BEADS_LISP_FILES@
BEADS_LISP_BASENAMES = @BEADS_LISP_BASENAMES@
BEADS_LISP_COMPILED = @BEADS_LISP_COMPILED@
BEADS_LISP_ELC_BASENAMES = @BEADS_LISP_ELC_BASENAMES@
BEADS_LISP_TEST_FILES = @BEADS_LISP_TEST_FILES@

AUTOLOADS_FILE = lisp/beads-autoloads.el

## Build-tree directory that receives the generated byte-code and
## autoloads.  It is created by the `byte-compile' and `$(AUTOLOADS_FILE)'
## rules before anything is written into it.
BEADS_BUILD_LISP_DIR = $(abs_builddir)/lisp

EXTRA_DIST = \
  autogen.sh \
  build-aux/beads-compile.el \
  build-aux/beads-autoloads.el \
  build-aux/beads-check.el \
  build-aux/beads-lint.el \
  build-aux/beads-coverage.el \
  m4/.gitkeep \
  guix.scm \
  scripts/dispatch-docs \
  scripts/lint \
  scripts/coverage \
  scripts/ci-deps \
  benchmarks \
  share \
  docs \
  $(BEADS_LISP_FILES) \
  $(BEADS_LISP_TEST_FILES)

all-local: byte-compile autoloads

## Byte-compile every lisp/*.el in one Emacs invocation.  The helper sets
## `byte-compile-error-on-warn' and compiles in dependency order so that a
## file is compiled before any other file loads it (loading a file sets the
## `interactive-only' property of its transient prefixes, which would turn
## a legitimate call from a wrapper command into a byte-compile warning).
byte-compile: $(BEADS_LISP_FILES)
	$(MKDIR_P) "$(BEADS_BUILD_LISP_DIR)"
	BEADS_COMPILE_OUT_DIR="$(BEADS_BUILD_LISP_DIR)" \
	  $(EMACS_BATCH) -l $(COMPILE_HELPER) $(BEADS_LISP_FILES)

## Generate beads-autoloads.el.  The helper preloads beads-meta.el (which
## pulls in beads-prefix.el) so `;;;###autoload' on beads-defcommand and
## beads-meta-define-transient forms macroexpand during generation.
autoloads: $(AUTOLOADS_FILE)

$(AUTOLOADS_FILE): $(BEADS_LISP_FILES)
	$(MKDIR_P) "$(BEADS_BUILD_LISP_DIR)"
	$(EMACS_BATCH) -l $(AUTOLOADS_HELPER) \
	  "$(abs_top_srcdir)/lisp" "$(abs_builddir)/$(AUTOLOADS_FILE)"

.PHONY: all-local byte-compile autoloads

install-data-local:
	$(MKDIR_P) "$(DESTDIR)$(lispdir)"
	$(INSTALL_DATA) $(BEADS_LISP_FILES) "$(DESTDIR)$(lispdir)/"
	$(INSTALL_DATA) $(BEADS_LISP_COMPILED) "$(DESTDIR)$(lispdir)/"
	$(INSTALL_DATA) "$(abs_builddir)/$(AUTOLOADS_FILE)" \
	  "$(DESTDIR)$(lispdir)/beads-autoloads.el"

uninstall-local:
	rm -f "$(DESTDIR)$(lispdir)"/$(BEADS_LISP_BASENAMES)
	rm -f "$(DESTDIR)$(lispdir)"/$(BEADS_LISP_ELC_BASENAMES)
	rm -f "$(DESTDIR)$(lispdir)/beads-autoloads.el"

clean-local:
	rm -f $(BEADS_LISP_COMPILED) $(AUTOLOADS_FILE)

## `make check' (REQ-006, REQ-008): the whole ERT suite in one Emacs
## invocation.  build-aux/beads-check.el drops stale project byte-code
## first (F2, be-47jo) and writes coverage/junit.xml from
## EMACS_TEST_JUNIT_REPORT (F3).
check-local:
	@BEADS_CHECK_TOOLS="bd=$(check_have_bd) dolt=$(check_have_dolt) graphviz=$(check_have_graphviz)" \
	  $(EMACS_BATCH_Q) -L "$(abs_top_srcdir)/lisp/test" -l $(CHECK_HELPER)

## `make lint' (REQ-008): package-lint plus byte-compile
## warnings-as-errors, via scripts/lint (no Eldev).
lint:
	EMACS="$(EMACS)" TRANSIENT_DIR="$(TRANSIENT_DIR)" VUI_DIR="$(VUI_DIR)" \
	  PACKAGE_LINT_DIR="@with_package_lint@" $(LINT_SCRIPT)

## `make coverage': the no-Eldev undercover run used by the Coverage
## workflow.  undercover is resolved from the ambient EMACSLOADPATH (the
## Guix `emacs-undercover' input or the CI install); the report lands at
## $COVERAGE_REPORT (default coverage/codecov.json) and the ERT JUnit
## report at $EMACS_TEST_JUNIT_REPORT (default coverage/junit.xml).
coverage:
	EMACS="$(EMACS)" TRANSIENT_DIR="$(TRANSIENT_DIR)" VUI_DIR="$(VUI_DIR)" \
	  $(COVERAGE_SCRIPT)

.PHONY: check-local lint coverage
