;;; beads-manual-reference-test.el --- Reference-completeness gate -*- lexical-binding: t; -*-

;; Copyright (C) 2026

;; Author: Beads Contributors
;; Keywords: test

;;; Commentary:

;; WI-08 (be-87yr2): the reference-completeness `:unit' gate for the
;; user manual.  It derives the user-visible inventory exactly as pinned
;; in the `BEGIN GENERATED' comment at the head of `doc/reference.texi'
;; (WI-07, be-50rac) and asserts that every name has a `@deffn'/`@defopt'
;; entry in `doc/*.texi'.  This mirrors the `scripts/dispatch-docs' drift
;; discipline (REQ-008, REQ-009): a user-visible command or user option
;; can no longer be added to the source without a reference entry.
;;
;; The derivation has three parts, matching the pinned rule:
;;
;;   1. COMMANDS.  Walk the four documented dispatch menus with
;;      `beads-transient-doc-suffixes', recursing into every suffix whose
;;      command is itself a transient prefix.  Each reachable `beads-*'
;;      command gets a `@deffn' entry; generated infix pseudo-commands
;;      (`transient:...') are ignored.
;;   2. EXECUTE SUFFIXES.  A reachable command NAME that also defines
;;      NAME--execute (the suffix generated by `beads-defcommand') gets an
;;      additional `@deffn NAME--execute' entry.
;;   3. USER OPTIONS.  Every symbol under `lisp/' for which
;;      `custom-variable-p' is non-nil gets exactly one `@defopt' entry.
;;
;; The gate is hermetic (`:unit', no `bd'): it reads the `lisp/' sources
;; for their transient layouts and `defcustom' definitions, and parses
;; only the Texinfo sources.  It loads the sources itself so the result
;; does not depend on test-file load order.  Removing one `@deffn' or
;; `@defopt' entry makes it fail naming that command or option.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'seq)
(require 'subr-x)
(require 'beads-dispatch-doc)
(require 'beads-transient-doc)

(defconst beads-manual-reference-test--root
  (expand-file-name "../.."
                    (file-name-directory
                     (or load-file-name buffer-file-name
                         (locate-library "beads-manual-reference-test"))))
  "Repository root, derived from this test file's location.")

(defconst beads-manual-reference-test--lisp-dir
  (expand-file-name "lisp" beads-manual-reference-test--root)
  "The `lisp/' source directory holding the command and option definitions.")

(defconst beads-manual-reference-test--manual-dir
  (expand-file-name "doc" beads-manual-reference-test--root)
  "The hand-authored Texinfo manual source directory.")

(defvar beads-manual-reference-test--sources-loaded nil
  "Non-nil once `lisp/*.el' has been loaded for the inventory walk.")

;;; Inventory derivation (the pinned rule)

(defun beads-manual-reference-test--load-sources ()
  "Load every `lisp/*.el' source so the inventory is complete.
The walk needs the transient layouts and the `defcustom' variables the
sources define, independent of test-file load order.  The `lisp/test/'
directory is excluded.  Loading is idempotent and happens once per
process."
  (unless beads-manual-reference-test--sources-loaded
    (dolist (file (directory-files beads-manual-reference-test--lisp-dir
                                   t "\\.el\\'"))
      (unless (string-match-p "/test/" file)
        (load file nil t)))
    (setq beads-manual-reference-test--sources-loaded t)))

(defun beads-manual-reference-test--suffixes (menus)
  "Return every distinct suffix `:command' reachable from MENUS.
MENUS is the `(PREFIX . TITLE)' list walked by `beads-transient-doc'.
Recurses into any suffix whose command is itself a transient prefix."
  (let (seen)
    (cl-labels
        ((walk (prefix)
               (dolist (entry (beads-transient-doc-suffixes prefix))
                 (let ((command (plist-get entry :command)))
                   (when (and (symbolp command) (not (memq command seen)))
                     (push command seen)
                     (when (get command 'transient--layout)
                       (walk command)))))))
      (dolist (menu menus) (walk (car menu))))
    (nreverse seen)))

(defun beads-manual-reference-test--commands ()
  "Return the distinct user-visible command names in the inventory.
A reachable suffix whose name starts with `beads-' contributes its base
name (a trailing `--execute' is stripped, so an execute-only binding
does not invent a command).  Generated infix pseudo-commands named
`transient:...' are not user-visible commands and are ignored."
  (beads-manual-reference-test--load-sources)
  (let (names)
    (dolist (suffix (beads-manual-reference-test--suffixes
                     beads-dispatch-doc-menus))
      (let ((name (symbol-name suffix)))
        (cond
         ((string-prefix-p "transient:" name) nil)
         ((string-prefix-p "beads-" name)
          (push (string-remove-suffix "--execute" name) names))
         ((get suffix 'transient--layout) (push name names)))))
    (sort (delete-dups names) #'string<)))

(defun beads-manual-reference-test--execute-suffixes (commands)
  "Return the generated `NAME--execute' names for COMMANDS.
A command contributes a suffix only when `NAME--execute' is actually
defined, matching the reference derivation."
  (seq-filter (lambda (name)
                (fboundp (intern (concat name "--execute"))))
              commands))

(defun beads-manual-reference-test--user-options ()
  "Return every user option (`defcustom') defined under `lisp/'."
  (beads-manual-reference-test--load-sources)
  (let ((prefix (file-name-as-directory beads-manual-reference-test--lisp-dir))
        options)
    (mapatoms
     (lambda (symbol)
       (when (custom-variable-p symbol)
         (let ((file (symbol-file symbol 'defvar)))
           (when (and file
                      (string-prefix-p prefix file)
                      (not (string-match-p "/test/" file)))
             (push (symbol-name symbol) options))))))
    (sort options #'string<)))

;;; Texinfo parsing

(defun beads-manual-reference-test--documented (files regexp)
  "Return the distinct names captured by REGEXP over FILES.
REGEXP must capture the name in its first group."
  (let (names)
    (dolist (file files)
      (with-temp-buffer
        (insert-file-contents file)
        (goto-char (point-min))
        (while (re-search-forward regexp nil t)
          (push (match-string 1) names))))
    (sort (delete-dups names) #'string<)))

(defun beads-manual-reference-test--manual-files ()
  "Return the absolute path of every Texinfo chapter under `doc/'."
  (directory-files beads-manual-reference-test--manual-dir t "\\.texi\\'"))

(defconst beads-manual-reference-test--deffn-regexp
  "^@deffn\\s-+{[^}]*}\\s-+\\(\\S-+\\)"
  "Regexp capturing the name of a Texinfo `@deffn' entry.")

(defconst beads-manual-reference-test--defopt-regexp
  "^@defopt\\s-+\\(\\S-+\\)"
  "Regexp capturing the name of a Texinfo `@defopt' entry.")

(defun beads-manual-reference-test--assert-covered (inventory documented label)
  "Fail unless every INVENTORY name appears in DOCUMENTED.
LABEL names the entry kind (\"command\", \"command ...\", \"user
option\") for the failure message.  Returns t when nothing is missing."
  (let ((missing (seq-remove (lambda (name) (member name documented))
                             inventory)))
    (when missing
      (ert-fail
       (format "reference-completeness: missing @deffn/@defopt entries for %s: %s"
               label (string-join missing ", "))))
    t))

;;; The gate

(ert-deftest beads-manual-reference-test-command-coverage ()
  "Every user-visible command has a @deffn entry (REQ-008)."
  :tags '(:unit :no-coverage)
  (let ((commands (beads-manual-reference-test--commands)))
    (should commands)
    (beads-manual-reference-test--assert-covered
     commands
     (beads-manual-reference-test--documented
      (beads-manual-reference-test--manual-files)
      beads-manual-reference-test--deffn-regexp)
     "user-visible commands")))

(ert-deftest beads-manual-reference-test-execute-suffix-coverage ()
  "Every generated command `--execute' suffix has a @deffn entry (REQ-008)."
  :tags '(:unit :no-coverage)
  (let ((suffixes (beads-manual-reference-test--execute-suffixes
                   (beads-manual-reference-test--commands))))
    (should suffixes)
    (beads-manual-reference-test--assert-covered
     (mapcar (lambda (name) (concat name "--execute")) suffixes)
     (beads-manual-reference-test--documented
      (beads-manual-reference-test--manual-files)
      beads-manual-reference-test--deffn-regexp)
     "generated command suffixes")))

(ert-deftest beads-manual-reference-test-user-option-coverage ()
  "Every user option has a @defopt entry (REQ-009)."
  :tags '(:unit :no-coverage)
  (let ((options (beads-manual-reference-test--user-options)))
    (should options)
    (beads-manual-reference-test--assert-covered
     options
     (beads-manual-reference-test--documented
      (beads-manual-reference-test--manual-files)
      beads-manual-reference-test--defopt-regexp)
     "user options")))

(ert-deftest beads-manual-reference-test-no-stale-reference-entries ()
  "`doc/reference.texi' documents no command or option outside the inventory.
This is the reverse direction of the completeness gate: a stale entry
left behind after a rename or removal must fail, mirroring the
`scripts/dispatch-docs' drift check."
  :tags '(:unit :no-coverage)
  (let* ((reference (expand-file-name "reference.texi"
                                      beads-manual-reference-test--manual-dir))
         (commands (beads-manual-reference-test--commands))
         (execute (mapcar (lambda (name) (concat name "--execute"))
                          (beads-manual-reference-test--execute-suffixes commands)))
         (options (beads-manual-reference-test--user-options))
         (documented-commands (beads-manual-reference-test--documented
                               (list reference)
                               beads-manual-reference-test--deffn-regexp))
         (documented-options (beads-manual-reference-test--documented
                              (list reference)
                              beads-manual-reference-test--defopt-regexp))
         (stale-commands (seq-remove
                          (lambda (name)
                            (or (member name commands) (member name execute)))
                          documented-commands))
         (stale-options (seq-remove (lambda (name) (member name options))
                                    documented-options)))
    (when stale-commands
      (ert-fail
       (format "reference-completeness: stale @deffn entries not in the inventory: %s"
               (string-join stale-commands ", "))))
    (when stale-options
      (ert-fail
       (format "reference-completeness: stale @defopt entries not in the inventory: %s"
               (string-join stale-options ", "))))
    (should (null stale-commands))
    (should (null stale-options))))

(provide 'beads-manual-reference-test)
;;; beads-manual-reference-test.el ends here
